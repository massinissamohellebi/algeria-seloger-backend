# Application
APP_NAME=algeria-seloger-backend
ENVIRONMENT=development
DEBUG=true

# PostgreSQL (used by docker-compose)
POSTGRES_USER=algeria
POSTGRES_PASSWORD=algeria
POSTGRES_DB=algeria_seloger

# Database (async driver required)
# Use "db" hostname in Docker, "localhost" for local dev
DATABASE_URL=postgresql+asyncpg://algeria:algeria@db:5432/algeria_seloger

# JWT / Auth
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-please-use-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# CORS (JSON array format)
CORS_ORIGINS=["http://algeria-seloger.localhost"]

# Traefik hostnames (for docker-compose labels)
API_HOST=api.localhost
ADMINER_HOST=adminer.localhost
MAILDEV_HOST=maildev.localhost

# Mailer + storage.
# The docker-compose backend service already wires these to the maildev +
# localstack containers (see its `environment:` block). Uncomment here only for
# a bare-metal (non-compose) run. Left as `console`/in-memory so a host-side
# `pytest` never reaches out to SMTP or S3.
# MAILER_BACKEND=console            # console | smtp
# MAIL_FROM=no-reply@algeria-seloger.dz
# SMTP_HOST=localhost               # maildev in compose
# SMTP_PORT=1025
# FRONTEND_BASE_URL=http://algeria-seloger.localhost
# S3_BUCKET=                        # empty = in-memory storage; "seloger-photos" for localstack
# S3_ENDPOINT_URL=http://localstack:4566
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test
# S3_PUBLIC_BASE_URL=http://localhost:4566/seloger-photos
